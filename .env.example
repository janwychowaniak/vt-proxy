# vt-proxy configuration (12-Factor env, SPEC §10).
# Copy to .env and fill in. NEVER commit .env; keep the canonical VAR=VALUE
# format (no spaces around '='— docker --env-file is strict about it).

VT_API_KEY=your-virustotal-api-key

# Optional overrides (defaults shown):
# VT_BASE_URL=https://www.virustotal.com/api/v3
# VT_TIMEOUT=30
# LOG_LEVEL=INFO

# Compose-only: host port published on 127.0.0.1 (SPEC: localhost-only).
# VT_PROXY_PORT=11000

# Outbound egress proxy, when deployed behind one (standard variables,
# honored by httpx via trust_env — SPEC §10):
# HTTPS_PROXY=http://proxy.example.internal:8080
# NO_PROXY=localhost,127.0.0.1
