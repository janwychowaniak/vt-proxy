# vt-proxy configuration (12-Factor env, SPEC §10).
# Copy to .env and fill in. NEVER commit .env; keep the canonical VAR=VALUE
# format (no spaces around '='— docker --env-file is strict about it).

VT_API_KEY=your-virustotal-api-key

# Optional overrides (defaults shown):
# VT_BASE_URL=https://www.virustotal.com/api/v3
# VT_TIMEOUT=30
# LOG_LEVEL=INFO

# Compose-only: host port published on 127.0.0.1 (SPEC: localhost-only).
# VT_PROXY_PORT=11000

# Outbound egress proxy, when deployed behind one (standard variables,
# honored by httpx via trust_env — SPEC §10):
# HTTPS_PROXY=http://proxy.example.internal:8080
# NO_PROXY=localhost,127.0.0.1

# Extra CA trust, when that proxy intercepts TLS (SPEC §10): a PEM file whose
# certificates are added to the default trust. With compose, the overlay
# compose.ca.yml mounts ./ca.pem and sets this variable itself.
# CA_FILE=/path/to/proxy-ca.pem

# Python's strict X.509 checks on TLS with VirusTotal (SPEC §10), on by default.
# Set false only for a proxy authority that fails them; that relaxes the checks
# for every chain the service verifies.
# X509_STRICT=true
